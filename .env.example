# Neon Postgres (pooled connection string recommended for serverless)
DATABASE_URL=
# Optional local backup (gitignored): copy URI into secrets/database.local.env — see secrets/README.md

# Optional: copy production DATABASE_URL here to seed / push the live Neon DB from your machine.
#   vercel env pull .env.production.local --environment=production --yes
# Then: npm run db:push:live   (schema)   npm run db:seed:live   (Chennai + articles)
# File name is fixed — do not commit it (.gitignore).

# Public site URL for metadata, sitemap, and robots — MUST be .in (not .com)
NEXT_PUBLIC_SITE_URL=https://mychennaicity.in

# Optional: after live article seeds, bust Vercel route cache immediately (POST /api/revalidate/news?secret=…&slug=…)
# After live job/event seeds: POST /api/revalidate/listings?secret=…&jobSlug=…&eventSlug=…  or  npm run revalidate:listings:live
# Set the same value on Vercel Production. Home/news lists already read Neon live without this.
# REVALIDATE_SECRET=

# Vercel Cron — auto gold rate sync (GET /api/cron/gold-rate). Vercel injects CRON_SECRET on cron invocations.
# Set CRON_SECRET on Vercel Production (generate: openssl rand -base64 32). Manual test: npm run gold-rate:sync:live
# CRON_SECRET=
# Optional: tune spot→Chennai retail conversion (default 10.5). No paid API required.
# GOLD_RATE_RETAIL_MARKUP_PERCENT=10.5

# Public contact email — production uses OFFICIAL_PUBLIC_CONTACT_EMAIL in src/lib/env.ts
# (mychennaicityportal@gmail.com). Override below only for local/staging testing:
# NEXT_PUBLIC_CONTACT_EMAIL=mychennaicityportal@gmail.com

# Optional: Google Search Console HTML tag verification — content token only (from GSC → HTML tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: extra profile URLs for Organization JSON-LD (comma-separated).
# Official Instagram is built in — see OFFICIAL_ORG_SAME_AS_URLS in src/lib/env.ts
# NEXT_PUBLIC_ORG_SAME_AS=https://www.youtube.com/@yourchannel

# Google Analytics 4 (Measurement ID G-...)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Newsletter modal — auto-open on home/articles/jobs/events. Leave unset/false before AdSense review.
# NEXT_PUBLIC_NEWSLETTER_AUTO_MODAL=false
# Site campaign / top-story modals (homepage first-visit + capped rotation). Prefer this over NEWSLETTER_AUTO_MODAL.
# NEXT_PUBLIC_SITE_MODAL_AUTO=false

# Optional: comma-separated client IPs — skip loading GA + AdSense for those visitors (server-only; set on Vercel for prod). See src/lib/analytics-ip-exclusion.ts
# ANALYTICS_EXCLUDE_IPS=203.0.113.10,2001:db8::1

# Optional: WhatsApp — server-only. UI links to /api/community/whatsapp and /api/contact/whatsapp (302); do not put digits or raw invite URLs in page source.
# Community group invite (https://chat.whatsapp.com/… from WhatsApp → group → invite link)
# WHATSAPP_COMMUNITY_INVITE_URL=https://chat.whatsapp.com/CnxfxABnv3YCgxhdSqEigd
# Business desk line for wa.me (accepts +91…, 91…, or 10-digit India mobile)
# WHATSAPP_BUSINESS_E164=

# Google AdSense — ads.txt seller id (public; same numeric id as ca-pub-)
# https://support.google.com/adsense/answer/12171612
# ADSENSE_PUBLISHER_ID=pub-5760699639501978
# Verification + auto ads script client id (default in code if unset; override below if needed):
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-5760699639501978
# Optional display slot ids (post-approval) — pair with ArticleAdRegion / GoogleAdSenseSlot
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=
# Must match the deployed site URL (include https, no trailing slash)
AUTH_URL=https://mychennaicity.in

# OAuth (optional; configure at least one for sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: Search Console API — npm run gsc:submit-sitemap
# Enable "Google Search Console API" in Google Cloud; create a service account JSON key.
# Add the service account email in GSC → Settings → Users and permissions (Full).
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json
# Or (CI): paste entire JSON as one line in GSC_SERVICE_ACCOUNT_JSON=
# GSC_SITE_URL=https://mychennaicity.in/
# URL-prefix props need trailing slash. Domain property: sc-domain:mychennaicity.in
# GSC_SITEMAP_URL=https://mychennaicity.in/sitemap.xml
