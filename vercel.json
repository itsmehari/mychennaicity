{
  "crons": [
    {
      "path": "/api/cron/gold-rate",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/gold-rate",
      "schedule": "30 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ]
}
